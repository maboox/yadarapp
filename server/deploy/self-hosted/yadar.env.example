# Copy to /etc/yadar.env, fill in, then: sudo chmod 600 /etc/yadar.env
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
OTP_SECRET=change-me-to-a-long-random-string
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
# Or for sms.ir:
# SMS_PROVIDER=smsir
# SMSIR_API_KEY=
# SMSIR_TEMPLATE_ID=
REVIEW_PHONE=
REVIEW_CODE=
