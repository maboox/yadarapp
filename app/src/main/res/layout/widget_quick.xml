<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:orientation="vertical" android:padding="16dp"
    android:background="@drawable/widget_violet">
    <TextView android:id="@+id/quick_header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="✦ یادار / ثبت سریع" android:textColor="#FFFFFF" android:textSize="16sp"
        android:textStyle="bold" android:singleLine="true" />
    <TextView android:id="@+id/quick_description" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:text="همین الان بگو یا بنویس؛ یادت می‌مونه."
        android:textColor="#ECE6FF" android:textSize="12sp" android:maxLines="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="12dp">
        <TextView android:id="@+id/quick_voice" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="43dp" android:background="@drawable/widget_white_chip"
            android:gravity="center" android:text="●  با ویس بگو" android:textColor="#3C2AA2"
            android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/quick_add" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="43dp" android:layout_marginStart="8dp"
            android:background="@drawable/widget_white_chip" android:gravity="center"
            android:text="＋  یادآوری جدید" android:textColor="#3C2AA2"
            android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
