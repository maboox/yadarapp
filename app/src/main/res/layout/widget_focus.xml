<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:orientation="vertical" android:padding="16dp"
    android:background="@drawable/widget_violet">
    <TextView android:id="@+id/focus_header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="✦ نزدیک‌ترین یادآوری" android:textColor="#E5DFFF" android:textSize="12sp" />
    <TextView android:id="@+id/focus_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="7dp" android:text="همه‌چیز رو به‌راهه" android:textColor="#FFFFFF"
        android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/focus_due" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="یادآوری ثبت نکردی" android:textColor="#E5DFFF"
        android:textSize="11sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="11dp">
        <TextView android:id="@+id/focus_open" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="36dp" android:background="@drawable/widget_white_chip"
            android:gravity="center" android:text="باز کردن" android:textColor="#3C2AA2"
            android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/focus_done" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="36dp" android:layout_marginStart="8dp"
            android:background="@drawable/widget_white_chip" android:gravity="center"
            android:text="✓  انجام شد" android:textColor="#3C2AA2"
            android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
