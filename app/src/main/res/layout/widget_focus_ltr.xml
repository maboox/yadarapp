<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:layoutDirection="ltr" android:padding="14dp" android:background="@drawable/widget_accent_bg">
    <TextView android:id="@+id/focus_header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="✦ نزدیک‌ترین یادآوری" android:textColor="#E5DFFF" android:textSize="11sp"
        android:textAlignment="viewStart" />
    <TextView android:id="@+id/focus_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"
        android:maxLines="2" android:ellipsize="end" android:textAlignment="viewStart" />
    <TextView android:id="@+id/focus_due" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:textColor="#E5DFFF" android:textSize="12sp"
        android:textAlignment="viewStart" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/focus_open" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="38dp" android:background="@drawable/widget_glass_button" android:gravity="center"
            android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/focus_done" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="38dp" android:layout_marginStart="8dp" android:background="@drawable/widget_white_button"
            android:gravity="center" android:textColor="#3B2DB0" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
