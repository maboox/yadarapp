<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/room_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_room_bg" android:clipToOutline="true">
    <ImageView android:id="@+id/room_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <!-- the episode: one child per frame, each putting Yadimo (and the ball, and what it says) in its place -->
    <ViewFlipper android:id="@+id/room_flipper" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layoutDirection="ltr" android:autoStart="true" android:flipInterval="125" />
    <!-- how full, rested and happy Yadimo is -->
    <LinearLayout android:id="@+id/room_stats" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|left" android:layout_margin="7dp" android:background="@drawable/widget_room_bubble"
        android:orientation="horizontal" android:gravity="center_vertical" android:layoutDirection="ltr"
        android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="2dp" android:paddingBottom="2dp">
        <TextView style="@style/RoomStatIcon" android:text="🍪" />
        <ProgressBar android:id="@+id/room_hunger" style="@style/RoomStatBar" />
        <TextView style="@style/RoomStatIcon" android:text="⚡" />
        <ProgressBar android:id="@+id/room_energy" style="@style/RoomStatBar" />
        <TextView style="@style/RoomStatIcon" android:text="😊" />
        <ProgressBar android:id="@+id/room_joy" style="@style/RoomStatBar" />
    </LinearLayout>
    <TextView android:id="@+id/room_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" android:layout_margin="8dp" android:background="@drawable/widget_room_bubble"
        android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone"
        android:textColor="#231C47" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
</FrameLayout>
